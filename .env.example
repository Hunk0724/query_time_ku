# Copy this file to `.env` (same directory) and fill in your key(s).
# `.env` is git-ignored and never committed.

# Required for all experiments (extraction, query, answer, LLM judge).
OPENAI_API_KEY=sk-...

# Optional — only needed to reproduce the Zep baseline rows (FC-SH tables).
# A Zep Cloud API key: https://www.getzep.com/
# ZEP_API_KEY=...
