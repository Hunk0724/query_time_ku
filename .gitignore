# Secrets — never ship. Keep .env.example (the template) tracked.
.env

# Python bytecode
__pycache__/
*.pyc

# Runtime artifacts (all regenerated on a run; see README §6)
outputs/                              # fresh FC-SH run products (reference is reference_outputs/)
logs/                                 # per-run cost/latency + stdout logs
agents/                               # engine agent-state cache (auto-created)
analysis/results/expanded/stores/     # Qdrant vector stores (rebuilt from shipped data)
analysis/results/lme_hyps/            # fresh LME-KU run products (reference is reference_outputs/lme_hyps/)

# Generated analysis products (regenerated by running the analysis/*.py scripts;
# the tracked inputs are p1_caches/ + sh_*_mquake_analysis.json only)
analysis/results/canonical_fc_sh_metrics.json
analysis/results/canonical_fc_sh_metrics.md
analysis/results/m1_m2_m3_results.md
analysis/results/pool_acc_crosstab.md

# Shipped reference is committed compressed as reference_outputs.tar.gz (Windows
# long-path safe); the extracted tree is ignored so it is never re-committed.
reference_outputs/

# OS cruft
.DS_Store
