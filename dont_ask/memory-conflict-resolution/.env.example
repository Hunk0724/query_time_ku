# Required: OpenAI API key
OPENAI_API_KEY=sk-...

# Optional: Langfuse tracing. Set these to enable per-call tracing of every
# experiment. If unset, you will need to comment out the `langfuse` imports
# in scripts/_lf.py (or stub `observe` as a no-op decorator).
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://us.cloud.langfuse.com
